# Learner storefront (apps/web). Copy to .env.local.

# Learner API base (browser). Server-side code prefers API_INTERNAL_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5096/api/v1
# Learner API base for server-side fetches inside containers (optional).
# API_INTERNAL_BASE_URL=http://learner-api:5096/api/v1

# Tenants are served at <slug>.<root domain>. lvh.me resolves to 127.0.0.1,
# so http://northwind.lvh.me:3620 works locally.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_RESERVED_SUBDOMAINS=www,admin,api,console

# Platform brand shown where no tenant is resolved (404 page, llms.txt).
NEXT_PUBLIC_PLATFORM_NAME=Open LMS Cloud
NEXT_PUBLIC_PLATFORM_URL=https://example.com

# Public base URLs of the asset store / CDN (relative keys are joined onto these).
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_THUMBNAILS_BASE_URL=
NEXT_PUBLIC_TENANT_ASSETS_BASE_URL=
NEXT_PUBLIC_PROFILE_BASE_URL=
# Comma separated remote image hosts for next/image (unset = allow any https host).
NEXT_PUBLIC_IMAGE_HOSTS=

# Payments
NEXT_PUBLIC_RAZORPAY_CHECKOUT_URL=https://checkout.razorpay.com/v1/checkout.js

# Optional integrations
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
# NEXT_PUBLIC_BOOK_AI_ENABLED=false

NEXT_PUBLIC_NODE_ENV=development

# Optional: Desmos API key for the graphing calculator in tests (https://www.desmos.com/api).
# Unset hides the calculator.
NEXT_PUBLIC_DESMOS_API_KEY=
