{
  "name": "@open-mtlms/admin-api",
  "version": "1.0.0",
  "description": "Tenant admin API (tier 2) for Open LMS Cloud",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist/",
    "build": "pnpm run clean && tsc",
    "build:prod": "pnpm run clean && tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "validate:capabilities": "tsx scripts/validate-capabilities.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:matcher": "tsx scripts/test-bulk-imports-matcher.ts",
    "test:matcher:race": "tsx scripts/test-bulk-imports-merge-race.ts",
    "sync:frontend-ids": "tsx scripts/sync-frontend-ids.ts",
    "validate:audit": "tsx scripts/validate-audit-coverage.ts",
    "validate": "pnpm run validate:capabilities && pnpm run validate:audit"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.36",
    "@aws-sdk/client-cloudwatch": "^3.996.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.996.0",
    "@aws-sdk/client-sns": "^3.996.0",
    "@aws-sdk/client-sqs": "^3.996.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "ai": "^6.0.97",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.0",
    "express-validator": "^7.3.1",
    "express-xss-sanitizer": "^2.0.1",
    "geoip-lite": "^2.0.1",
    "helmet": "^8.1.0",
    "ip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "kysely": "^0.28.8",
    "mammoth": "^1.12.0",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "redis": "^5.10.0",
    "sharp": "^0.34.5",
    "sqs-consumer": "^11.6.0",
    "ulid": "^2.3.0",
    "winston": "^3.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/express-xss-sanitizer": "^2.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/ip": "^1.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.1.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.12"
  }
}
