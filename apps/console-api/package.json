{
  "name": "@open-mtlms/console-api",
  "version": "1.0.0",
  "description": "Operator console API: plans, entitlements, tenants and billing providers.",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist/",
    "build": "pnpm run clean && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "echo \"no unit tests in console-api\" && exit 0",
    "seed:permissions": "tsx scripts/seed-admin-permissions.ts",
    "seed:roles": "tsx scripts/seed-roles.ts",
    "sync:admin-permissions": "tsx scripts/sync-admin-permissions.ts",
    "seed:tenant-rbac": "tsx scripts/seed-tenant-rbac.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "bootstrap:operator": "tsx scripts/bootstrap-operator.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "seed": "tsx scripts/seed-admin-permissions.ts && tsx scripts/seed-roles.ts && tsx scripts/seed-tenant-rbac.ts && tsx scripts/seed-catalog.ts",
    "build:scripts": "tsc -p tsconfig.scripts.json"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1021.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "express-xss-sanitizer": "^2.0.1",
    "geoip-lite": "^2.0.1",
    "helmet": "^8.1.0",
    "ip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "moment": "^2.30.1",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "ulid": "^3.0.2",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-xss-sanitizer": "^2.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/ip": "^1.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
