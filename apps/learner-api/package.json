    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "express-xss-sanitizer": "^2.0.1",
    "geoip-lite": "^2.0.1",
