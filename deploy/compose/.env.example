# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
MTLMS_JWT_SECRET=replace-with-output-of-make-env
MTLMS_LEARNER_JWT_SECRET=replace-with-output-of-make-env
# Seals every gateway credential a tenant stores. Changing it makes the stored ones
# unreadable (re-enter them in the app).
MTLMS_CREDENTIALS_ENCRYPTION_KEY=replace-with-output-of-make-env
# Shared by the three APIs for service-to-service calls.
MTLMS_INTERNAL_API_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password (passed to the seed as
# DEMO_PASSWORD).
MTLMS_DEMO_PASSWORD=replace-with-output-of-make-env

# Stripe, Razorpay, the video system (EVS) and the OpenAI-compatible AI endpoint are the
# local `stubs` service. To use a real test account instead, point the API at it, e.g.:
# STRIPE_API_BASE=https://api.stripe.com
# RAZORPAY_API_BASE=https://api.razorpay.com
# EVS_API_URL=https://video.example.com
# EVS_API_KEY=...
# Tenants store their own gateway keys in the tenant admin (sealed with the key above).

# AI authoring: offline (deterministic) by default.
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_TEXT_MODEL=
# AI_IMAGE_MODEL=

# Product analytics in the three web apps (off unless set).
# NEXT_PUBLIC_POSTHOG_KEY=

# Optional overrides (host ports and names)
# MTLMS_BRAND_NAME=Open LMS Cloud
# MTLMS_ROOT_DOMAIN=lvh.me
# LOG_LEVEL=info
# MTLMS_CONSOLE_PORT=3600
# MTLMS_ADMIN_PORT=3610
# MTLMS_WEB_PORT=3620
# MTLMS_CONSOLE_API_PORT=5076
# MTLMS_ADMIN_API_PORT=5086
# MTLMS_LEARNER_API_PORT=5096
# MTLMS_PG_PORT=5542
# MTLMS_REDIS_PORT=6479
# MTLMS_STUBS_PORT=5189
# MTLMS_FLOCI_PORT=4647
# MTLMS_MAILPIT_PORT=8096
# MTLMS_MAILPIT_SMTP_PORT=1096
