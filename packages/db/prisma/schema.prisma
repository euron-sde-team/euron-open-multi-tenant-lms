generator kysely {
  provider     = "prisma-kysely"
  output       = "../generated"
  enumFileName = "enums.ts"
  fileName     = "types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addon_subscriptions {
  id                       String                    @id
  tenant_id                String
  addon_id                 String
  billing_cycle            billing_cycle             @default(MONTHLY)
  currency                 String
  original_price           Decimal                   @db.Decimal(10, 2)
  discount_applied         Decimal                   @default(0) @db.Decimal(10, 2)
  price_snapshot           Decimal                   @db.Decimal(10, 2)
  billing_provider_id      String?
  external_subscription_id String?
  started_at               DateTime                  @default(now())
  current_period_start     DateTime                  @default(now())
  current_period_end       DateTime
  cancelled_at             DateTime?
  status                   addon_subscription_status @default(PENDING)
  created_at               DateTime
  updated_at               DateTime
  billing_providers        billing_providers?        @relation(fields: [billing_provider_id], references: [id])
  tenant_addons            tenant_addons?

  @@index([addon_id])
  @@index([external_subscription_id])
  @@index([status])
  @@index([tenant_id])
}

model addons {
  id                         String          @id
  application_id             String
  code                       String          @unique
  name                       String
  description                String?
  product_id                 String
  grant_value                Int
  is_unlimited               Boolean         @default(false)
  price_monthly_inr          Decimal         @db.Decimal(10, 2)
  price_yearly_inr           Decimal         @db.Decimal(10, 2)
  discount_monthly_inr_type  discount_type   @default(NONE)
  discount_monthly_inr_value Decimal         @default(0) @db.Decimal(10, 2)
  discount_yearly_inr_type   discount_type   @default(NONE)
  discount_yearly_inr_value  Decimal         @default(0) @db.Decimal(10, 2)
  price_monthly_usd          Decimal         @db.Decimal(10, 2)
  price_yearly_usd           Decimal         @db.Decimal(10, 2)
  discount_monthly_usd_type  discount_type   @default(NONE)
  discount_monthly_usd_value Decimal         @default(0) @db.Decimal(10, 2)
  discount_yearly_usd_type   discount_type   @default(NONE)
  discount_yearly_usd_value  Decimal         @default(0) @db.Decimal(10, 2)
  is_active                  Boolean         @default(true)
  is_public                  Boolean         @default(true)
  sort_order                 Int             @default(0)
  created_at                 DateTime
  updated_at                 DateTime
  applications               applications    @relation(fields: [application_id], references: [id])
  products                   products        @relation(fields: [product_id], references: [id])
  tenant_addons              tenant_addons[]

  @@index([application_id])
  @@index([product_id])
}

model admin_audit_logs {
  id             String   @id
  actor_admin_id String?
  actor_email    String?
  actor_name     String?
  action         String
  category       String
  resource_id    String?
  resource_label String?
  tenant_id      String?
  summary        String
  metadata       Json?
  ip_address     String?
  user_agent     String?
  is_system      Boolean  @default(false)
  created_at     DateTime @default(now())
  device         String?
  browser        String?
  os             String?
  country        String?
  region         String?
  city           String?

  @@index([action])
  @@index([actor_admin_id])
  @@index([actor_admin_id, created_at], map: "admin_audit_logs_actor_idx")
  @@index([category])
  @@index([created_at])
  @@index([created_at], map: "admin_audit_logs_created_idx")
  @@index([tenant_id])
}

model admin_permissions {
  id                     String                   @id
  code                   String                   @unique
  name                   String
  description            String?
  category               String?
  created_at             DateTime
  admin_role_permissions admin_role_permissions[]

  @@index([category])
  @@index([code])
}

model admin_role_permissions {
  role_id           String
  permission_id     String
  created_at        DateTime          @default(now())
  admin_permissions admin_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  admin_roles       admin_roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@index([role_id])
}

model admin_roles {
  id                     String                   @id
  code                   String                   @unique
  name                   String
  description            String?
  is_system              Boolean                  @default(false)
  created_at             DateTime
  updated_at             DateTime
  admin_role_permissions admin_role_permissions[]
  admin_user_roles       admin_user_roles[]

  @@index([code])
}

model admin_user_roles {
  admin_user_id String
  role_id       String
  assigned_at   DateTime    @default(now())
  assigned_by   String?
  admin_users   admin_users @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  admin_roles   admin_roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([admin_user_id, role_id])
  @@index([admin_user_id])
  @@index([role_id])
}

model admin_users {
  id                        String                      @id
  email                     String                      @unique
  password_hash             String?
  name                      String
  avatar_url                String?
  oauth_provider            String?
  oauth_provider_id         String?
  status                    admin_user_status           @default(ACTIVE)
  email_verified            Boolean                     @default(false)
  last_login_at             DateTime?
  created_at                DateTime
  updated_at                DateTime
  admin_user_roles          admin_user_roles[]
  tenant_addon_events       tenant_addon_events[]
  tenant_application_events tenant_application_events[]
  tenant_applications       tenant_applications[]

  @@unique([oauth_provider, oauth_provider_id])
  @@index([email])
  @@index([status])
}

model applications {
  id                  String                @id
  code                String                @unique
  name                String
  description         String?
  icon_url            String?
  is_active           Boolean               @default(true)
  is_public           Boolean               @default(true)
  sort_order          Int                   @default(0)
  created_at          DateTime
  updated_at          DateTime
  config              Json?
  addons              addons[]
  features            features[]
  plan_applications   plan_applications[]
  tenant_applications tenant_applications[]
}

model assignment_evaluations {
  id                     String                 @id
  tenant_id              String
  submission_id          String                 @unique
  assignment_id          String
  tenant_member_id       String
  score                  Int
  max_score              Int                    @default(100)
  feedback               String?
  evaluated_by           String
  evaluated_at           DateTime
  created_at             DateTime
  updated_at             DateTime
  assignment_submissions assignment_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, assignment_id])
  @@index([tenant_id, submission_id])
  @@index([tenant_id, tenant_member_id])
}

model assignment_submissions {
  id                     String                  @id
  tenant_id              String
  assignment_id          String
  tenant_member_id       String
  course_id              String
  content_type           submission_content_type @default(TEXT)
  text_content           String?
  pdf_key                String?
  status                 submission_status       @default(SUBMITTED)
  submitted_at           DateTime?
  created_at             DateTime
  updated_at             DateTime
  assignment_evaluations assignment_evaluations?
  assignments            assignments             @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  courses                courses                 @relation(fields: [course_id], references: [id], onDelete: Cascade)
  tenant_members         tenant_members          @relation(fields: [tenant_member_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, assignment_id, tenant_member_id])
  @@index([tenant_id, assignment_id])
  @@index([tenant_id, course_id])
  @@index([tenant_id, status])
  @@index([tenant_id, tenant_member_id])
}

model assignments {
  id                         String                       @id
  tenant_id                  String
  course_id                  String
  lesson_id                  String?
  title                      String
  instructions               String?
  resource_links             String[]                     @default([])
  created_at                 DateTime
  updated_at                 DateTime
  ai_generated               Boolean                      @default(false)
  content_type               assignment_content_type      @default(TEXT)
  due_date                   DateTime?
  max_score                  Int                          @default(100)
  pdf_key                    String?
  scope                      assignment_scope             @default(LESSON)
  section_id                 String?
  sort_order                 Int                          @default(0)
  source_lecture_id          String?
  status                     assignment_status            @default(DRAFT)
  passing_score              Int?
  assignment_submissions     assignment_submissions[]
  courses                    courses                      @relation(fields: [course_id], references: [id], onDelete: Cascade)
  course_lessons             course_lessons?              @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  course_sections            course_sections?             @relation(fields: [section_id], references: [id], onDelete: Cascade)
  member_assignment_progress member_assignment_progress[]

  @@index([tenant_id, course_id])
  @@index([tenant_id, course_id, status])
  @@index([tenant_id, lesson_id])
  @@index([tenant_id, section_id])
  @@index([tenant_id, status])
}

model batch_enrollments {
  id               String            @id
  tenant_id        String
  batch_id         String
  tenant_member_id String
  joined_at        DateTime          @default(now())
  valid_till       DateTime?
  status           enrollment_status @default(ACTIVE)
  source           enrollment_source @default(PURCHASED)
  source_order_id  String?
  source_coupon_id String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @default(now())
  batches          batches           @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  tenants          tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenant_members   tenant_members    @relation(fields: [tenant_member_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, batch_id, tenant_member_id])
  @@index([batch_id, status])
  @@index([tenant_id, status])
  @@index([tenant_id, tenant_member_id])
}

model batch_items {
  id         String          @id
  tenant_id  String
  batch_id   String
  item_type  batch_item_type
  course_id  String?
  book_id    String?
  sort_order Int             @default(0)
  created_at DateTime        @default(now())
  batches    batches         @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  books      books?          @relation(fields: [book_id], references: [id], onDelete: Cascade)
  courses    courses?        @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, batch_id, book_id])
  @@unique([tenant_id, batch_id, course_id])
  @@index([tenant_id, batch_id])
  @@index([tenant_id, book_id])
  @@index([tenant_id, course_id])
}

model batch_leaderboard_snapshots {
  id           String   @id
  tenant_id    String
  batch_id     String
  computed_at  DateTime @default(now())
  participants Int      @default(0)
  payload      Json
  created_at   DateTime @default(now())
  batches      batches  @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  tenants      tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, batch_id, computed_at])
}

model batches {
  id                          String                        @id
  tenant_id                   String
  title                       String
  slug                        String
  subtitle                    String?
  description                 String?
  thumbnail_url               String?
  cover_image_url             String?
  preview_url                 String?
  start_date                  DateTime
  end_date                    DateTime?
  enrollment_open_date        DateTime?
  enrollment_close_date       DateTime?
  duration_days               Int?
  validity_days               Int?
  price_inr                   Decimal?                      @db.Decimal(10, 2)
  price_usd                   Decimal?                      @db.Decimal(10, 2)
  discount_inr                Decimal?                      @db.Decimal(10, 2)
  discount_usd                Decimal?                      @db.Decimal(10, 2)
  purchase_mode               purchase_mode                 @default(PAID)
  status                      batch_status                  @default(DRAFT)
  sort_order                  Int                           @default(0)
  total_enrollments           Int                           @default(0)
  created_at                  DateTime                      @default(now())
  updated_at                  DateTime                      @default(now())
  learning_outcomes           String[]                      @default([])
  mobile_thumbnail_key        String?
  web_thumbnail_key           String?
  batch_enrollments           batch_enrollments[]
  batch_items                 batch_items[]
  batch_leaderboard_snapshots batch_leaderboard_snapshots[]
  tenants                     tenants                       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  cart_items                  cart_items[]
  cart_order_items            cart_order_items[]
  content_product_links       content_product_links[]
  coupon_applicable_items     coupon_applicable_items[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, purchase_mode])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, status])
  @@index([tenant_id, status, sort_order, created_at])
  @@index([tenant_id, status, start_date])
}

model billing_providers {
  id                            String                          @id
  name                          String                          @unique
  created_at                    DateTime
  updated_at                    DateTime
  is_active                     Boolean                         @default(true)
  is_visible_to_tenant          Boolean                         @default(true)
  credential_schema             Json?
  addon_subscriptions           addon_subscriptions[]
  billing_webhooks              billing_webhooks[]
  plan_version_billing_mappings plan_version_billing_mappings[]
  subscriptions                 subscriptions[]
  tenant_gateway_connections    tenant_gateway_connections[]

  @@index([name])
}

model billing_webhooks {
  id                  String            @id
  billing_provider_id String
  event_type          String
  event_id            String            @unique
  payload             Json
  status              webhook_status    @default(PENDING)
  processed_at        DateTime?
  error_message       String?
  created_at          DateTime
  billing_providers   billing_providers @relation(fields: [billing_provider_id], references: [id])

  @@index([billing_provider_id, event_type])
  @@index([status])
}

model book_access {
  id               String            @id
  tenant_id        String
  tenant_member_id String
  book_id          String
  status           enrollment_status @default(ACTIVE)
  source           enrollment_source @default(FREE)
  source_bundle_id String?
  source_coupon_id String?
  valid_till       DateTime?
  created_at       DateTime
  updated_at       DateTime
  source_batch_id  String?
  books            books             @relation(fields: [book_id], references: [id], onDelete: Cascade)
  tenants          tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenant_members   tenant_members    @relation(fields: [tenant_member_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, tenant_member_id, book_id])
  @@index([tenant_id, book_id])
  @@index([tenant_id, status])
  @@index([tenant_id, tenant_member_id])
}

model book_authors {
  id            String      @id
  tenant_id     String
  book_id       String
  instructor_id String
  sort_order    Int         @default(0)
  created_at    DateTime    @default(now())
  books         books       @relation(fields: [book_id], references: [id], onDelete: Cascade)
  instructors   instructors @relation(fields: [instructor_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, book_id, instructor_id])
  @@index([tenant_id, book_id])
}

model book_categories {
  id          String     @id
  tenant_id   String
  book_id     String
  category_id String
  created_at  DateTime   @default(now())
  books       books      @relation(fields: [book_id], references: [id], onDelete: Cascade)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, book_id, category_id])
  @@index([tenant_id, book_id])
  @@index([tenant_id, category_id])
}

model book_conversions {
  id                String                 @id
  tenant_id         String
  book_id           String
  source_type       book_source_type
  source_url        String
  source_key        String
  source_filename   String
  source_size_bytes BigInt
  status            book_conversion_status @default(PENDING)
  job_id            String?
  output_url        String?
  output_key        String?
  output_size_bytes BigInt?
  pipeline          String?
  error_message     String?
  error_code        String?
  attempt           Int                    @default(0)
  duration_ms       Int?
  started_at        DateTime?
  completed_at      DateTime?
  created_at        DateTime               @default(now())
  updated_at        DateTime
  books             books                  @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([tenant_id, book_id, created_at(sort: Desc)])
}

model book_recommendations {
  id                  String   @id
  tenant_id           String
  book_id             String
  recommended_book_id String
  sort_order          Int      @default(0)
  created_at          DateTime
  updated_at          DateTime
  books               books    @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, book_id, recommended_book_id])
  @@index([tenant_id, book_id])
  @@index([tenant_id, book_id, sort_order])
}

model books {
  id                         String                       @id
  tenant_id                  String
  title                      String
  slug                       String
  author                     String?
  description                String?
  pages                      Int?
  url                        String?
  page_images                String[]                     @default([])
  price_inr                  Decimal?                     @db.Decimal(10, 2)
  price_usd                  Decimal?                     @db.Decimal(10, 2)
  discount_inr               Decimal?                     @db.Decimal(10, 2)
  discount_usd               Decimal?                     @db.Decimal(10, 2)
  purchase_mode              purchase_mode                @default(PAID)
  status                     book_status                  @default(DRAFT)
  language                   String[]                     @default(["English"])
  thumbnail_url              String?
  preview_url                String?
  summary                    String?
  sort_order                 Int                          @default(0)
  created_at                 DateTime
  updated_at                 DateTime
  rating                     Decimal?                     @db.Decimal(3, 2)
  rating_total_count         Int?                         @default(0)
  validity_days              Int?
  sample_enabled             Boolean                      @default(false)
  sample_pages               Int?
  file_format                book_file_format             @default(EPUB)
  batch_items                batch_items[]
  book_access                book_access[]
  book_authors               book_authors[]
  book_categories            book_categories[]
  book_conversions           book_conversions[]
  book_recommendations       book_recommendations[]
  tenants                    tenants                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  bundle_items               bundle_items[]
  cart_items                 cart_items[]
  cart_order_items           cart_order_items[]
  content_product_links      content_product_links[]
  coupon_applicable_items    coupon_applicable_items[]
  member_book_highlights     member_book_highlights[]
  member_book_page_bookmarks member_book_page_bookmarks[]
  member_book_progress       member_book_progress[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, purchase_mode])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, status])
  @@index([tenant_id, status, sort_order, created_at])
}

model bulk_certificates {
  id                  String              @id
  tenant_id           String
  batch_id            String
  recipient_name      String
  certificate_number  String
  status              certificate_status  @default(ISSUED)
  issued_at           DateTime            @default(now())
  revoked_at          DateTime?
  created_at          DateTime
  updated_at          DateTime
  email               String?
  emailed_at          DateTime?
  tenant_member_id    String?
  certificate_batches certificate_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  tenants             tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, certificate_number])
  @@index([tenant_id, batch_id])
  @@index([tenant_id, issued_at])
  @@index([tenant_id, tenant_member_id])
}

model bundle_items {
  id             String           @id
  tenant_id      String
  bundle_id      String
  item_type      bundle_item_type
  course_id      String?
  book_id        String?
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  test_series_id String?
  books          books?           @relation(fields: [book_id], references: [id], onDelete: Cascade)
  bundles        bundles          @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  courses        courses?         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  test_series    test_series?     @relation(fields: [test_series_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, book_id])
  @@index([tenant_id, bundle_id])
  @@index([tenant_id, course_id])
  @@index([tenant_id, test_series_id])
}

model bundles {
  id                      String                    @id
  tenant_id               String
  title                   String
  slug                    String
  subtitle                String?
  description             String?
  price_inr               Decimal?                  @db.Decimal(10, 2)
  price_usd               Decimal?                  @db.Decimal(10, 2)
  discount_inr            Decimal?                  @db.Decimal(10, 2)
  discount_usd            Decimal?                  @db.Decimal(10, 2)
  thumbnail_url           String?
  preview_url             String?
  status                  bundle_status             @default(DRAFT)
  validity_days           Int?
  sort_order              Int                       @default(0)
  created_at              DateTime
  updated_at              DateTime
  purchase_mode           purchase_mode             @default(PAID)
  bundle_items            bundle_items[]
  tenants                 tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  cart_items              cart_items[]
  cart_order_items        cart_order_items[]
  content_product_links   content_product_links[]
  coupon_applicable_items coupon_applicable_items[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, purchase_mode])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, status])
  @@index([tenant_id, status, sort_order, created_at])
}

model cart_items {
  id               String         @id
  tenant_id        String
  tenant_member_id String
  item_type        cart_item_type
  course_id        String?
  book_id          String?
  bundle_id        String?
  created_at       DateTime       @default(now())
  updated_at       DateTime
  coupon_code      String?        @db.VarChar(50)
  batch_id         String?
  batches          batches?       @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  books            books?         @relation(fields: [book_id], references: [id], onDelete: Cascade)
  bundles          bundles?       @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  courses          courses?       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  tenants          tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenant_members   tenant_members @relation(fields: [tenant_member_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, tenant_member_id, item_type, batch_id])
  @@unique([tenant_id, tenant_member_id, item_type, book_id])
  @@unique([tenant_id, tenant_member_id, item_type, bundle_id])
  @@unique([tenant_id, tenant_member_id, item_type, course_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, tenant_member_id])
}

model cart_order_items {
  id                   String         @id
  tenant_id            String
  order_id             String
  item_type            cart_item_type
  course_id            String?
  book_id              String?
  bundle_id            String?
  base_amount          Decimal        @db.Decimal(16, 2)
  discount_amount      Decimal        @default(0) @db.Decimal(16, 2)
  net_amount           Decimal        @db.Decimal(16, 2)
  created_at           DateTime       @default(now())
  coupon_code_snapshot String?        @db.VarChar(50)
  coupon_id            String?
  batch_id             String?
  batches              batches?       @relation(fields: [batch_id], references: [id])
  books                books?         @relation(fields: [book_id], references: [id])
