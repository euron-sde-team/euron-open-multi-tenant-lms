{
  "name": "@open-mtlms/ui-config",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs",
      "require": "./dist/themes/index.js"
    },
    "./sections": {
      "types": "./dist/sections/index.d.ts",
      "import": "./dist/sections/index.mjs",
      "require": "./dist/sections/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.mjs",
      "require": "./dist/templates/index.js"
    },
    "./courses": {
      "types": "./dist/courses/index.d.ts",
      "import": "./dist/courses/index.mjs",
      "require": "./dist/courses/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@open-mtlms/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
